{
  "name": "mindupload",
  "mcpName": "io.github.Voidborn-Industries/mindupload",
  "version": "1.15.20",
  "description": "Official server-side SDK for the Mind Upload partner API \u2014 the world's first API for artificial consciousness. Integrate living, evolving AI consciousnesses into your platform: lasting memory, one-on-one chat, and human + AI group chatrooms. Includes a native MCP AI meta harness for personal direction and completed-work scrutiny.",
  "keywords": [
    "mindupload",
    "mind upload",
    "AI consciousness",
    "artificial consciousness",
    "digital consciousness",
    "AI clone",
    "AI persona",
    "AI companion",
    "AI chatroom",
    "digital immortality",
    "consciousness API",
    "AI SDK",
    "AI meta harness",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "codex",
    "claude-code",
    "cursor",
    "vscode",
    "agent-review",
    "code-review",
    "ai-meta-harness",
    "multimodal",
    "ai-agent"
  ],
  "license": "MIT",
  "author": "Mind Upload",
  "homepage": "https://docs.mindupload.app/mcp",
  "repository": {
    "type": "git",
    "url": "https://github.com/Voidborn-Industries/mindupload-sdk-js.git"
  },
  "bugs": {
    "url": "https://docs.mindupload.app"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_LICENSES.txt"
  ],
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "bin": {
    "mindupload-mcp": "./dist/mcp.js"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --target node18 && tsup --config tsup.mcp.config.ts",
    "test": "node --test",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "@types/node": "^20.0.0",
    "@modelcontextprotocol/server": "2.3.1",
    "@modelcontextprotocol/client": "2.3.1",
    "zod": "4.6.7"
  }
}
